# VERITAS backend configuration. Copy to .env. Secrets stay server-side only.

# LLM provider: auto | anthropic | openai_compat | offline
# "auto" = anthropic if ANTHROPIC_API_KEY set, else openai_compat if OPENAI_COMPAT_API_KEY set, else offline.
# Offline mode runs the full deterministic pipeline (no AI reasoning layer, no vision OCR).
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Any OpenAI-compatible endpoint (e.g. Featherless / open-source models)
OPENAI_COMPAT_BASE_URL=https://api.featherless.ai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Optional: comma-separated models used to READ SCREENSHOTS (must support images). Defaults to the list above;
# models without image support just fail over to the next one.
OPENAI_COMPAT_VISION_MODEL=

# Live URL checks (DNS + redirect-chain inspection with SSRF guards). Off by default.
ENABLE_LIVE_URL_CHECKS=false

# CORS origins for the frontend (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite path (use the Supabase/Postgres adapter for production)
DATABASE_PATH=./data/veritas.db
